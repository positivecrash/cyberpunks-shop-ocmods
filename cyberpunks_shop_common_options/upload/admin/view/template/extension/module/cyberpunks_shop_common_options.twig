{% macro field_row(field, field_row, section_row, entry_key, entry_label, entry_type, entry_select_options, entry_admin_hint, entry_sort_order, entry_status, text_text, text_checkbox, text_select, text_html, text_textarea, text_image, text_enabled, text_disabled, help_select_options, help_admin_hint, button_remove) %}
<tr id="common-option-field-row-{{ field_row }}" class="common-option-field-row" data-section-row="{{ section_row }}">
  <td class="text-left">
    <input type="hidden" name="cyberpunks_common_option_defs[{{ field_row }}][field_id]" value="{{ field.field_id is defined ? field.field_id : '' }}" />
    <input type="hidden" name="cyberpunks_common_option_defs[{{ field_row }}][section_row]" value="{{ section_row }}" class="cyberpunks-common-option-section-row" />
    <input type="text" name="cyberpunks_common_option_defs[{{ field_row }}][field_key]" value="{{ field.field_key is defined ? field.field_key : '' }}" class="form-control" />
  </td>
  <td class="text-left"><input type="text" name="cyberpunks_common_option_defs[{{ field_row }}][label]" value="{{ field.label is defined ? field.label : '' }}" class="form-control" /></td>
  <td class="text-left">
    <select name="cyberpunks_common_option_defs[{{ field_row }}][field_type]" class="form-control cyberpunks-common-option-field-type">
      <option value="text" {% if field.field_type is not defined or field.field_type == 'text' %}selected="selected"{% endif %}>{{ text_text }}</option>
      <option value="checkbox" {% if field.field_type is defined and field.field_type == 'checkbox' %}selected="selected"{% endif %}>{{ text_checkbox }}</option>
      <option value="select" {% if field.field_type is defined and field.field_type == 'select' %}selected="selected"{% endif %}>{{ text_select }}</option>
      <option value="html" {% if field.field_type is defined and field.field_type == 'html' %}selected="selected"{% endif %}>{{ text_html }}</option>
      <option value="textarea" {% if field.field_type is defined and field.field_type == 'textarea' %}selected="selected"{% endif %}>{{ text_textarea }}</option>
      <option value="image" {% if field.field_type is defined and field.field_type == 'image' %}selected="selected"{% endif %}>{{ text_image }}</option>
    </select>
  </td>
  <td class="text-left"><textarea name="cyberpunks_common_option_defs[{{ field_row }}][select_options]" rows="3" class="form-control" placeholder="{{ help_select_options }}">{{ field.select_options is defined ? field.select_options : '' }}</textarea></td>
  <td class="text-left"><input type="text" name="cyberpunks_common_option_defs[{{ field_row }}][admin_hint]" value="{{ field.admin_hint is defined ? field.admin_hint : '' }}" class="form-control" placeholder="{{ help_admin_hint }}" /></td>
  <td class="text-right"><input type="text" name="cyberpunks_common_option_defs[{{ field_row }}][sort_order]" value="{{ field.sort_order is defined ? field.sort_order : 0 }}" class="form-control" /></td>
  <td class="text-left">
    <select name="cyberpunks_common_option_defs[{{ field_row }}][status]" class="form-control">
      <option value="1" {% if field.status is not defined or field.status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
      <option value="0" {% if field.status is defined and not field.status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
    </select>
  </td>
  <td class="text-right"><button type="button" onclick="$('#common-option-field-row-{{ field_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>
</tr>
{% endmacro %}

{% import _self as common_options %}

{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-cyberpunks-common-options" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-cyberpunks-common-options" class="form-horizontal">
      <input type="hidden" name="active_tab" value="{{ active_tab }}" id="common-options-active-tab" />
      {% set field_row = 0 %}

      <ul class="nav nav-tabs">
        <li{% if active_tab == 'values' %} class="active"{% endif %}><a href="#tab-common-options-values" data-toggle="tab">{{ text_values }}</a></li>
        <li{% if active_tab == 'definitions' %} class="active"{% endif %}><a href="#tab-common-options-definitions" data-toggle="tab">{{ text_definitions }}</a></li>
      </ul>

      <div class="tab-content">
        <div class="tab-pane{% if active_tab == 'values' %} active{% endif %}" id="tab-common-options-values">
          <div class="panel panel-default">
            <div class="panel-body">
              <p class="help-block">{{ help_values }}</p>
              {% include 'extension/module/cyberpunks_shop_common_options_values.twig' %}
            </div>
          </div>
        </div>

        <div class="tab-pane{% if active_tab == 'definitions' %} active{% endif %}" id="tab-common-options-definitions">
          <div class="panel panel-default">
            <div class="panel-body">
              <p class="help-block">{{ help_sections }}</p>

          <div class="panel panel-default" id="common-option-section-ungrouped">
            <div class="panel-heading"><strong>{{ text_ungrouped }}</strong></div>
            <div class="panel-body">
              <table class="table table-striped table-bordered table-hover cyberpunks-common-options-table" data-section-row="-1">
                <thead>
                  <tr>
                    <td class="text-left">{{ entry_key }}</td>
                    <td class="text-left">{{ entry_label }}</td>
                    <td class="text-left">{{ entry_type }}</td>
                    <td class="text-left">{{ entry_select_options }}</td>
                    <td class="text-left">{{ entry_admin_hint }}</td>
                    <td class="text-right">{{ entry_sort_order }}</td>
                    <td class="text-left">{{ entry_status }}</td>
                    <td></td>
                  </tr>
                </thead>
                <tbody>
                  {% for field in layout.ungrouped_fields %}
                  {{ common_options.field_row(field, field_row, -1, entry_key, entry_label, entry_type, entry_select_options, entry_admin_hint, entry_sort_order, entry_status, text_text, text_checkbox, text_select, text_html, text_textarea, text_image, text_enabled, text_disabled, help_select_options, help_admin_hint, button_remove) }}
                  {% set field_row = field_row + 1 %}
                  {% endfor %}
                </tbody>
                <tfoot>
                  <tr>
                    <td colspan="7"></td>
                    <td class="text-right"><button type="button" onclick="addCommonOptionField(-1);" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>

          <div id="cyberpunks-common-option-sections">
            {% for section in layout.sections %}
            {% set current_section_row = section.section_row is defined ? section.section_row : loop.index0 %}
            <div class="panel panel-default common-option-section-panel" id="common-option-section-{{ current_section_row }}" data-section-row="{{ current_section_row }}">
              <div class="panel-heading">
                <div class="row">
                  <div class="col-sm-5">
                    <input type="hidden" name="cyberpunks_common_option_sections[{{ current_section_row }}][section_id]" value="{{ section.section_id is defined ? section.section_id : '' }}" />
                    <input type="text" name="cyberpunks_common_option_sections[{{ current_section_row }}][title]" value="{{ section.title is defined ? section.title : '' }}" class="form-control" placeholder="{{ entry_section_title }}" />
                  </div>
                  <div class="col-sm-2">
                    <input type="text" name="cyberpunks_common_option_sections[{{ current_section_row }}][sort_order]" value="{{ section.sort_order is defined ? section.sort_order : 0 }}" class="form-control" placeholder="{{ entry_sort_order }}" />
                  </div>
                  <div class="col-sm-5 text-right">
                    <button type="button" onclick="removeCommonOptionSection({{ current_section_row }});" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
                  </div>
                </div>
              </div>
              <div class="panel-body">
                <table class="table table-striped table-bordered table-hover cyberpunks-common-options-table" data-section-row="{{ current_section_row }}">
                  <thead>
                    <tr>
                      <td class="text-left">{{ entry_key }}</td>
                      <td class="text-left">{{ entry_label }}</td>
                      <td class="text-left">{{ entry_type }}</td>
                      <td class="text-left">{{ entry_select_options }}</td>
                      <td class="text-left">{{ entry_admin_hint }}</td>
                      <td class="text-right">{{ entry_sort_order }}</td>
                      <td class="text-left">{{ entry_status }}</td>
                      <td></td>
                    </tr>
                  </thead>
                  <tbody>
                    {% for field in section.fields %}
                    {{ common_options.field_row(field, field_row, current_section_row, entry_key, entry_label, entry_type, entry_select_options, entry_admin_hint, entry_sort_order, entry_status, text_text, text_checkbox, text_select, text_html, text_textarea, text_image, text_enabled, text_disabled, help_select_options, help_admin_hint, button_remove) }}
                    {% set field_row = field_row + 1 %}
                    {% endfor %}
                  </tbody>
                  <tfoot>
                    <tr>
                      <td colspan="7"></td>
                      <td class="text-right"><button type="button" onclick="addCommonOptionField({{ current_section_row }});" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </div>
            {% endfor %}
          </div>

          <div class="text-right" style="margin-top:15px;">
            <button type="button" onclick="addCommonOptionSection();" class="btn btn-default"><i class="fa fa-plus-circle"></i> {{ button_add_section }}</button>
          </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
<script type="text/javascript"><!--
var common_option_field_row = {{ field_row }};
var common_option_section_row = {{ next_section_row }};

function buildCommonOptionFieldRow(fieldRow, sectionRow) {
  var html = '';
  html += '<tr id="common-option-field-row-' + fieldRow + '" class="common-option-field-row" data-section-row="' + sectionRow + '">';
  html += '  <td class="text-left"><input type="hidden" name="cyberpunks_common_option_defs[' + fieldRow + '][field_id]" value="" /><input type="hidden" name="cyberpunks_common_option_defs[' + fieldRow + '][section_row]" value="' + sectionRow + '" class="cyberpunks-common-option-section-row" /><input type="text" name="cyberpunks_common_option_defs[' + fieldRow + '][field_key]" value="" class="form-control" /></td>';
  html += '  <td class="text-left"><input type="text" name="cyberpunks_common_option_defs[' + fieldRow + '][label]" value="" class="form-control" /></td>';
  html += '  <td class="text-left"><select name="cyberpunks_common_option_defs[' + fieldRow + '][field_type]" class="form-control cyberpunks-common-option-field-type"><option value="text">{{ text_text }}</option><option value="checkbox">{{ text_checkbox }}</option><option value="select">{{ text_select }}</option><option value="html">{{ text_html }}</option><option value="textarea">{{ text_textarea }}</option><option value="image">{{ text_image }}</option></select></td>';
  html += '  <td class="text-left"><textarea name="cyberpunks_common_option_defs[' + fieldRow + '][select_options]" rows="3" class="form-control" placeholder="{{ help_select_options }}"></textarea></td>';
  html += '  <td class="text-left"><input type="text" name="cyberpunks_common_option_defs[' + fieldRow + '][admin_hint]" value="" class="form-control" placeholder="{{ help_admin_hint }}" /></td>';
  html += '  <td class="text-right"><input type="text" name="cyberpunks_common_option_defs[' + fieldRow + '][sort_order]" value="0" class="form-control" /></td>';
  html += '  <td class="text-left"><select name="cyberpunks_common_option_defs[' + fieldRow + '][status]" class="form-control"><option value="1">{{ text_enabled }}</option><option value="0">{{ text_disabled }}</option></select></td>';
  html += '  <td class="text-right"><button type="button" onclick="$(\'#common-option-field-row-' + fieldRow + '\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
  html += '</tr>';
  return html;
}

function addCommonOptionField(sectionRow) {
  var selector = sectionRow === -1
    ? '#common-option-section-ungrouped .cyberpunks-common-options-table tbody'
    : '#common-option-section-' + sectionRow + ' .cyberpunks-common-options-table tbody';

  $(selector).append(buildCommonOptionFieldRow(common_option_field_row, sectionRow));
  common_option_field_row++;
}

function buildCommonOptionSectionPanel(sectionRow) {
  var html = '';
  html += '<div class="panel panel-default common-option-section-panel" id="common-option-section-' + sectionRow + '" data-section-row="' + sectionRow + '">';
  html += '  <div class="panel-heading"><div class="row">';
  html += '    <div class="col-sm-5"><input type="hidden" name="cyberpunks_common_option_sections[' + sectionRow + '][section_id]" value="" /><input type="text" name="cyberpunks_common_option_sections[' + sectionRow + '][title]" value="" class="form-control" placeholder="{{ entry_section_title }}" /></div>';
  html += '    <div class="col-sm-2"><input type="text" name="cyberpunks_common_option_sections[' + sectionRow + '][sort_order]" value="0" class="form-control" placeholder="{{ entry_sort_order }}" /></div>';
  html += '    <div class="col-sm-5 text-right"><button type="button" onclick="removeCommonOptionSection(' + sectionRow + ');" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></div>';
  html += '  </div></div>';
  html += '  <div class="panel-body"><table class="table table-striped table-bordered table-hover cyberpunks-common-options-table" data-section-row="' + sectionRow + '">';
  html += '    <thead><tr><td class="text-left">{{ entry_key }}</td><td class="text-left">{{ entry_label }}</td><td class="text-left">{{ entry_type }}</td><td class="text-left">{{ entry_select_options }}</td><td class="text-left">{{ entry_admin_hint }}</td><td class="text-right">{{ entry_sort_order }}</td><td class="text-left">{{ entry_status }}</td><td></td></tr></thead>';
  html += '    <tbody></tbody>';
  html += '    <tfoot><tr><td colspan="7"></td><td class="text-right"><button type="button" onclick="addCommonOptionField(' + sectionRow + ');" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td></tr></tfoot>';
  html += '  </table></div></div>';
  return html;
}

function addCommonOptionSection() {
  $('#cyberpunks-common-option-sections').append(buildCommonOptionSectionPanel(common_option_section_row));
  common_option_section_row++;
}

function removeCommonOptionSection(sectionRow) {
  $('#common-option-section-' + sectionRow).remove();
}

$('a[data-toggle="tab"]').on('shown.bs.tab', function(e) {
  var target = $(e.target).attr('href') || '';
  if (target === '#tab-common-options-values') {
    $('#common-options-active-tab').val('values');
  } else if (target === '#tab-common-options-definitions') {
    $('#common-options-active-tab').val('definitions');
  }
});
//--></script>
{{ footer }}
