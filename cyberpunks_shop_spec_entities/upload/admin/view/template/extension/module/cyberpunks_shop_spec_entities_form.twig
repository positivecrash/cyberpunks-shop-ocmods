{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-spec-entity" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-spec-entity" class="form-horizontal">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
            <li><a href="#tab-items" data-toggle="tab">{{ tab_items }}</a></li>
          </ul>
          <div class="tab-content">
            <div class="tab-pane active" id="tab-general">
              <ul class="nav nav-tabs" id="language">
                {% for language in languages %}
                <li{% if loop.first %} class="active"{% endif %}><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
                {% endfor %}
              </ul>
              <div class="tab-content">
                {% for language in languages %}
                <div class="tab-pane{% if loop.first %} active{% endif %}" id="language{{ language.language_id }}">
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-name{{ language.language_id }}">{{ entry_name }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="spec_entity_description[{{ language.language_id }}][name]" value="{{ spec_entity_description[language.language_id] is defined ? spec_entity_description[language.language_id].name : '' }}" placeholder="{{ entry_name }}" id="input-name{{ language.language_id }}" class="form-control" />
                      {% if error_name[language.language_id] is defined %}
                      <div class="text-danger">{{ error_name[language.language_id] }}</div>
                      {% endif %}
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-description{{ language.language_id }}">{{ entry_description }}</label>
                    <div class="col-sm-10">
                      <textarea name="spec_entity_description[{{ language.language_id }}][description]" placeholder="{{ entry_description }}" id="input-description{{ language.language_id }}" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ spec_entity_description[language.language_id] is defined ? spec_entity_description[language.language_id].description : '' }}</textarea>
                    </div>
                  </div>
                </div>
                {% endfor %}
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
                <div class="col-sm-10">
                  <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <select name="status" id="input-status" class="form-control">
                    {% if status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
            </div>
            <div class="tab-pane" id="tab-items">
              <div id="spec-entity-items">
                {% set item_row = 0 %}
                {% for item in spec_entity_items %}
                <div class="panel panel-default spec-entity-item" id="spec-item-row-{{ item_row }}">
                  <div class="panel-heading">
                    <button type="button" class="btn btn-danger btn-xs pull-right" onclick="$('#spec-item-row-{{ item_row }}').remove();"><i class="fa fa-minus-circle"></i> {{ button_remove }}</button>
                    <input type="text" name="spec_entity_item[{{ item_row }}][sort_order]" value="{{ item.sort_order is defined ? item.sort_order : item_row }}" class="form-control input-sm pull-right" style="width: 80px; margin-right: 10px;" />
                    <strong>{{ entry_item_name }}</strong>
                  </div>
                  <div class="panel-body">
                    <ul class="nav nav-tabs">
                      {% for language in languages %}
                      <li{% if loop.first %} class="active"{% endif %}><a href="#spec-item-{{ item_row }}-language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
                      {% endfor %}
                    </ul>
                    <div class="tab-content">
                      {% for language in languages %}
                      <div class="tab-pane{% if loop.first %} active{% endif %}" id="spec-item-{{ item_row }}-language{{ language.language_id }}">
                        <div class="form-group">
                          <label class="col-sm-2 control-label">{{ entry_item_name }}</label>
                          <div class="col-sm-10">
                            <input type="text" name="spec_entity_item[{{ item_row }}][spec_entity_item_description][{{ language.language_id }}][name]" value="{{ item.spec_entity_item_description[language.language_id] is defined ? item.spec_entity_item_description[language.language_id].name : '' }}" class="form-control" />
                          </div>
                        </div>
                        <div class="form-group">
                          <label class="col-sm-2 control-label">{{ entry_item_description }}</label>
                          <div class="col-sm-10">
                            <textarea name="spec_entity_item[{{ item_row }}][spec_entity_item_description][{{ language.language_id }}][description]" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control spec-entity-item-summernote">{{ item.spec_entity_item_description[language.language_id] is defined ? item.spec_entity_item_description[language.language_id].description : '' }}</textarea>
                          </div>
                        </div>
                      </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
                {% set item_row = item_row + 1 %}
                {% endfor %}
              </div>
              <button type="button" onclick="addSpecEntityItem();" class="btn btn-primary"><i class="fa fa-plus-circle"></i> {{ button_add }}</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript" src="view/javascript/summernote/summernote.min.js"></script>
<link href="view/javascript/summernote/summernote.min.css" rel="stylesheet" />
<script type="text/javascript" src="view/javascript/summernote/summernote-image-attributes.js"></script>
<script type="text/javascript" src="view/javascript/summernote/opencart.js"></script>
<script type="text/javascript"><!--
var spec_entity_item_row = {{ item_row }};
var spec_entity_languages = [
{% for language in languages %}
  { language_id: {{ language.language_id }}, code: '{{ language.code }}', name: '{{ language.name|e('js') }}' }{% if not loop.last %},{% endif %}
{% endfor %}
];

function initSpecEntitySummernote($context) {
  $context.find('textarea[data-toggle="summernote"]:not(.note-editor)').each(function() {
    var element = this;

    if ($(this).attr('data-lang') && $(this).attr('data-lang') != 'en-gb') {
      $('head').append('<script type="text/javascript" src="view/javascript/summernote/lang/summernote-' + $(this).attr('data-lang') + '.min.js"><\/script>');
    }

    $(element).summernote({
      lang: $(this).attr('data-lang'),
      height: 200,
      disableDragAndDrop: true
    });
  });
}

function addSpecEntityItem() {
  var html = '';
  html += '<div class="panel panel-default spec-entity-item" id="spec-item-row-' + spec_entity_item_row + '">';
  html += '  <div class="panel-heading">';
  html += '    <button type="button" class="btn btn-danger btn-xs pull-right" onclick="$(\'#spec-item-row-' + spec_entity_item_row + '\').remove();"><i class="fa fa-minus-circle"></i> {{ button_remove }}</button>';
  html += '    <input type="text" name="spec_entity_item[' + spec_entity_item_row + '][sort_order]" value="' + spec_entity_item_row + '" class="form-control input-sm pull-right" style="width: 80px; margin-right: 10px;" />';
  html += '    <strong>{{ entry_item_name }}</strong>';
  html += '  </div>';
  html += '  <div class="panel-body">';
  html += '    <ul class="nav nav-tabs">';

  for (var i = 0; i < spec_entity_languages.length; i++) {
    html += '      <li' + (i === 0 ? ' class="active"' : '') + '><a href="#spec-item-' + spec_entity_item_row + '-language' + spec_entity_languages[i].language_id + '" data-toggle="tab"><img src="language/' + spec_entity_languages[i].code + '/' + spec_entity_languages[i].code + '.png" title="' + spec_entity_languages[i].name + '" /> ' + spec_entity_languages[i].name + '</a></li>';
  }

  html += '    </ul>';
  html += '    <div class="tab-content">';

  for (var j = 0; j < spec_entity_languages.length; j++) {
    html += '      <div class="tab-pane' + (j === 0 ? ' active' : '') + '" id="spec-item-' + spec_entity_item_row + '-language' + spec_entity_languages[j].language_id + '">';
    html += '        <div class="form-group">';
    html += '          <label class="col-sm-2 control-label">{{ entry_item_name }}</label>';
    html += '          <div class="col-sm-10"><input type="text" name="spec_entity_item[' + spec_entity_item_row + '][spec_entity_item_description][' + spec_entity_languages[j].language_id + '][name]" value="" class="form-control" /></div>';
    html += '        </div>';
    html += '        <div class="form-group">';
    html += '          <label class="col-sm-2 control-label">{{ entry_item_description }}</label>';
    html += '          <div class="col-sm-10"><textarea name="spec_entity_item[' + spec_entity_item_row + '][spec_entity_item_description][' + spec_entity_languages[j].language_id + '][description]" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control spec-entity-item-summernote"></textarea></div>';
    html += '        </div>';
    html += '      </div>';
  }

  html += '    </div>';
  html += '  </div>';
  html += '</div>';

  var $row = $(html);
  $('#spec-entity-items').append($row);
  initSpecEntitySummernote($row);
  spec_entity_item_row++;
}
//--></script>
{{ footer }}
