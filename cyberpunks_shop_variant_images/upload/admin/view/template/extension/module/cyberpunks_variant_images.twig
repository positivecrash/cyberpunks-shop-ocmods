              '<td class="text-left">{{ entry_signature|e('js') }}<br><small>{{ help_signature|e('js') }}</small></td>' +
              '<td class="text-left">{{ entry_image|e('js') }}<br><small>{{ help_image|e('js') }}</small></td>' +
              '<td class="text-left">{{ entry_mapping_status|e('js') }}</td>' +
              '<td></td>' +
            '</tr></thead>' +
            '<tbody id="tbody-product-' + productId + '"></tbody>' +
            '<tfoot><tr><td colspan="3"></td><td class="text-right"><button type="button" class="btn btn-primary js-add-mapping-btn" data-product-id="' + productId + '"><i class="fa fa-plus-circle"></i></button></td></tr></tfoot>' +
          '</table>' +
        '</div>' +
        '<div style="display:flex;justify-content:space-between;align-items:center;"><div><button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save|e('js') }}</button> <a href="' + exportUrlBase + productId + '" class="btn btn-default"><i class="fa fa-download"></i> {{ button_export|e('js') }}</a></div><div><button type="submit" name="delete_tab_action" value="1" class="btn btn-danger" onclick="return confirm(\\\'{{ text_confirm_delete_tab|e('js') }}\\\');"><i class="fa fa-trash"></i> {{ button_delete_tab|e('js') }}</button></div></div>' +
      '</form>' +
