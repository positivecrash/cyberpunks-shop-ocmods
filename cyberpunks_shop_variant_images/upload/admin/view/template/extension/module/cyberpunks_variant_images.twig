        '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;"><div><button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save|e('js') }}</button></div><div><button type="submit" name="delete_tab_action" value="1" class="btn btn-danger" onclick="return confirm(\\\'{{ text_confirm_delete_tab|e('js') }}\\\');"><i class="fa fa-trash"></i> {{ button_delete_tab|e('js') }}</button></div></div>' +
        '<div class="table-responsive">' +
