{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-cyberpunks-product-fields" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-cyberpunks-product-fields" class="form-horizontal">
          <table id="cyberpunks-product-fields" class="table table-striped table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-left">{{ entry_key }}</td>
                <td class="text-left">{{ entry_label }}</td>
                <td class="text-left">{{ entry_type }}</td>
                <td class="text-left">{{ entry_select_options }}</td>
                <td class="text-left">{{ entry_admin_hint }}</td>
                <td class="text-right">{{ entry_sort_order }}</td>
                <td class="text-left">{{ entry_status }}</td>
                <td></td>
              </tr>
            </thead>
            <tbody>
              {% set field_row = 0 %}
              {% for field in fields %}
              <tr id="product-field-row-{{ field_row }}">
                <td class="text-left">
                  <input type="hidden" name="cyberpunks_product_field_defs[{{ field_row }}][field_id]" value="{{ field.field_id is defined ? field.field_id : '' }}" />
                  <input type="text" name="cyberpunks_product_field_defs[{{ field_row }}][field_key]" value="{{ field.field_key is defined ? field.field_key : '' }}" class="form-control" />
                </td>
                <td class="text-left"><input type="text" name="cyberpunks_product_field_defs[{{ field_row }}][label]" value="{{ field.label is defined ? field.label : '' }}" class="form-control" /></td>
                <td class="text-left">
                  <select name="cyberpunks_product_field_defs[{{ field_row }}][field_type]" class="form-control cyberpunks-product-field-type">
                    <option value="text" {% if field.field_type is not defined or field.field_type == 'text' %}selected="selected"{% endif %}>{{ text_text }}</option>
                    <option value="checkbox" {% if field.field_type is defined and field.field_type == 'checkbox' %}selected="selected"{% endif %}>{{ text_checkbox }}</option>
                    <option value="select" {% if field.field_type is defined and field.field_type == 'select' %}selected="selected"{% endif %}>{{ text_select }}</option>
                  </select>
                </td>
                <td class="text-left"><textarea name="cyberpunks_product_field_defs[{{ field_row }}][select_options]" rows="3" class="form-control" placeholder="{{ help_select_options }}">{{ field.select_options is defined ? field.select_options : '' }}</textarea></td>
                <td class="text-left"><input type="text" name="cyberpunks_product_field_defs[{{ field_row }}][admin_hint]" value="{{ field.admin_hint is defined ? field.admin_hint : '' }}" class="form-control" placeholder="{{ help_admin_hint }}" /></td>
                <td class="text-right"><input type="text" name="cyberpunks_product_field_defs[{{ field_row }}][sort_order]" value="{{ field.sort_order is defined ? field.sort_order : 0 }}" class="form-control" /></td>
                <td class="text-left">
                  <select name="cyberpunks_product_field_defs[{{ field_row }}][status]" class="form-control">
                    <option value="1" {% if field.status is not defined or field.status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                    <option value="0" {% if field.status is defined and not field.status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                  </select>
                </td>
                <td class="text-right"><button type="button" onclick="$('#product-field-row-{{ field_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>
              </tr>
              {% set field_row = field_row + 1 %}
              {% endfor %}
            </tbody>
            <tfoot>
              <tr>
                <td colspan="7"></td>
                <td class="text-right"><button type="button" onclick="addProductField();" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td>
              </tr>
            </tfoot>
          </table>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var product_field_row = {{ field_row }};

function addProductField() {
  var html = '';
  html += '<tr id="product-field-row-' + product_field_row + '">';
  html += '  <td class="text-left"><input type="hidden" name="cyberpunks_product_field_defs[' + product_field_row + '][field_id]" value="" /><input type="text" name="cyberpunks_product_field_defs[' + product_field_row + '][field_key]" value="" class="form-control" /></td>';
  html += '  <td class="text-left"><input type="text" name="cyberpunks_product_field_defs[' + product_field_row + '][label]" value="" class="form-control" /></td>';
  html += '  <td class="text-left"><select name="cyberpunks_product_field_defs[' + product_field_row + '][field_type]" class="form-control cyberpunks-product-field-type"><option value="text">{{ text_text }}</option><option value="checkbox">{{ text_checkbox }}</option><option value="select">{{ text_select }}</option></select></td>';
  html += '  <td class="text-left"><textarea name="cyberpunks_product_field_defs[' + product_field_row + '][select_options]" rows="3" class="form-control" placeholder="{{ help_select_options }}"></textarea></td>';
  html += '  <td class="text-left"><input type="text" name="cyberpunks_product_field_defs[' + product_field_row + '][admin_hint]" value="" class="form-control" placeholder="{{ help_admin_hint }}" /></td>';
  html += '  <td class="text-right"><input type="text" name="cyberpunks_product_field_defs[' + product_field_row + '][sort_order]" value="0" class="form-control" /></td>';
  html += '  <td class="text-left"><select name="cyberpunks_product_field_defs[' + product_field_row + '][status]" class="form-control"><option value="1">{{ text_enabled }}</option><option value="0">{{ text_disabled }}</option></select></td>';
  html += '  <td class="text-right"><button type="button" onclick="$(\'#product-field-row-' + product_field_row + '\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
  html += '</tr>';

  $('#cyberpunks-product-fields tbody').append(html);
  product_field_row++;
}
//--></script>
{{ footer }}
