<?xml version="1.0" encoding="utf-8"?>
<modification>
	<name>Cyberpunks Shop Product Fields</name>
	<code>cyberpunks_shop_product_fields</code>
	<version>1.0.2</version>
	<author>positivecrash</author>
	<link>https://github.com/positivecrash</link>

	<file path="admin/controller/catalog/product.php">
		<operation error="skip">
			<search trim="false"><![CDATA[			$this->model_catalog_product->addProduct($this->request->post);]]></search>
			<add position="replace"><![CDATA[			$product_id = $this->model_catalog_product->addProduct($this->request->post);
			$this->load->model('extension/module/cyberpunks_shop_product_fields');
			$this->model_extension_module_cyberpunks_shop_product_fields->install();
			$this->model_extension_module_cyberpunks_shop_product_fields->saveProductFieldValues((int)$product_id, isset($this->request->post['cyberpunks_product_fields']) ? $this->request->post['cyberpunks_product_fields'] : array());]]></add>
		</operation>

		<operation error="skip">
			<search trim="false"><![CDATA[			$this->model_catalog_product->editProduct($this->request->get['product_id'], $this->request->post);]]></search>
			<add position="after"><![CDATA[
			$this->load->model('extension/module/cyberpunks_shop_product_fields');
			$this->model_extension_module_cyberpunks_shop_product_fields->install();
			$this->model_extension_module_cyberpunks_shop_product_fields->saveProductFieldValues((int)$this->request->get['product_id'], isset($this->request->post['cyberpunks_product_fields']) ? $this->request->post['cyberpunks_product_fields'] : array());
]]></add>
		</operation>

		<operation error="skip">
			<search trim="false"><![CDATA[				$this->model_catalog_product->deleteProduct($product_id);]]></search>
			<add position="after"><![CDATA[
				$this->load->model('extension/module/cyberpunks_shop_product_fields');
				$this->model_extension_module_cyberpunks_shop_product_fields->deleteProductFieldValues((int)$product_id);
]]></add>
		</operation>

		<operation error="skip">
			<search trim="false"><![CDATA[		if (isset($this->request->post['product_layout'])) {]]></search>
			<add position="before"><![CDATA[		$this->load->model('extension/module/cyberpunks_shop_product_fields');
		$this->model_extension_module_cyberpunks_shop_product_fields->install();
		$data['cyberpunks_product_fields'] = $this->model_extension_module_cyberpunks_shop_product_fields->getFields(true);

		if (isset($this->request->post['cyberpunks_product_fields']) && is_array($this->request->post['cyberpunks_product_fields'])) {
			$data['cyberpunks_product_field_values'] = $this->request->post['cyberpunks_product_fields'];
		} elseif (!empty($product_info) && isset($product_info['product_id'])) {
			$data['cyberpunks_product_field_values'] = $this->model_extension_module_cyberpunks_shop_product_fields->getProductFieldValues((int)$product_info['product_id']);
		} else {
			$data['cyberpunks_product_field_values'] = array();
		}

		$data['cyberpunks_shop_product_fields_form'] = $this->load->view('extension/module/cyberpunks_shop_product_fields_product_form', $data);

]]></add>
		</operation>
	</file>

	<file path="admin/view/template/catalog/product_form.twig">
		<operation error="skip">
			<search trim="false"><![CDATA[<li><a href="#tab-data" data-toggle="tab">{{ tab_data }}</a></li>]]></search>
			<add position="after"><![CDATA[<li><a href="#tab-cyberpunks-product-fields" data-toggle="tab">Custom</a></li>
]]></add>
		</operation>

		<operation error="skip">
			<search trim="false"><![CDATA[<div class="tab-pane" id="tab-links">]]></search>
			<add position="before"><![CDATA[      <div class="tab-pane" id="tab-cyberpunks-product-fields">
              {{ cyberpunks_shop_product_fields_form }}
      </div>

]]></add>
		</operation>
	</file>

	<file path="catalog/controller/product/product.php">
		<operation error="skip">
			<search trim="false"><![CDATA[			$this->document->setKeywords($product_info['meta_keyword']);]]></search>
			<add position="after"><![CDATA[
			$this->load->model('extension/module/cyberpunks_shop_product_fields');
			$cyberpunks_product_fields_map = $this->model_extension_module_cyberpunks_shop_product_fields->getProductFieldsMap((int)$this->request->get['product_id']);

			if (!isset($data['fields']) || !is_array($data['fields'])) {
				$data['fields'] = array();
			}

			$data['fields'] = array_merge($data['fields'], $cyberpunks_product_fields_map);

			$this->registry->set('cyberpunks_product_fields', $cyberpunks_product_fields_map);
]]></add>
		</operation>
	</file>

	<file path="catalog/controller/common/header.php">
		<operation error="skip">
			<search trim="false"><![CDATA[		$data['keywords'] = $this->document->getKeywords();]]></search>
			<add position="after"><![CDATA[
		$data['cyberpunks_product_fields'] = $this->registry->has('cyberpunks_product_fields') ? (array)$this->registry->get('cyberpunks_product_fields') : array();
]]></add>
		</operation>
	</file>
</modification>
