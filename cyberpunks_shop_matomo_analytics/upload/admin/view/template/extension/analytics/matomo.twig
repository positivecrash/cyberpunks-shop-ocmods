{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-matomo" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_setup_hint }}</div>
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-matomo" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-server">{{ entry_server }}</label>
            <div class="col-sm-10">
              <input type="url" name="analytics_matomo_server" value="{{ analytics_matomo_server }}" placeholder="https://matomo.example.com" id="input-server" class="form-control"/>
              <p class="help-block">{{ text_help_server }}</p>
              {% if error_server %}
              <div class="text-danger">{{ error_server }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-site-id">{{ entry_site_id }}</label>
            <div class="col-sm-10">
              <input type="number" name="analytics_matomo_site_id" value="{{ analytics_matomo_site_id }}" min="1" id="input-site-id" class="form-control" style="max-width:120px"/>
              <p class="help-block">{{ text_help_site_id }}</p>
              {% if error_site_id %}
              <div class="text-danger">{{ error_site_id }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="analytics_matomo_status" id="input-status" class="form-control" style="max-width:200px">
                {% if analytics_matomo_status == '1' or analytics_matomo_status == 1 %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-ecommerce">{{ entry_ecommerce }}</label>
            <div class="col-sm-10">
              <select name="analytics_matomo_ecommerce" id="input-ecommerce" class="form-control" style="max-width:200px">
                {% if analytics_matomo_ecommerce == '1' or analytics_matomo_ecommerce == 1 %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
              <p class="help-block">{{ text_help_ecommerce }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sku">{{ entry_sku_field }}</label>
            <div class="col-sm-10">
              <select name="analytics_matomo_sku_field" id="input-sku" class="form-control" style="max-width:280px">
                <option value="model" {% if analytics_matomo_sku_field == 'model' %}selected="selected"{% endif %}>{{ text_sku_model }}</option>
                <option value="sku" {% if analytics_matomo_sku_field == 'sku' %}selected="selected"{% endif %}>{{ text_sku_sku }}</option>
              </select>
              <p class="help-block">{{ text_help_sku }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-disable-cookies">{{ entry_disable_cookies }}</label>
            <div class="col-sm-10">
              <select name="analytics_matomo_disable_cookies" id="input-disable-cookies" class="form-control" style="max-width:200px">
                {% if analytics_matomo_disable_cookies == '1' or analytics_matomo_disable_cookies == 1 %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
              <p class="help-block">{{ text_help_disable_cookies }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-dnt">{{ entry_respect_dnt }}</label>
            <div class="col-sm-10">
              <select name="analytics_matomo_respect_dnt" id="input-dnt" class="form-control" style="max-width:200px">
                {% if analytics_matomo_respect_dnt == '1' or analytics_matomo_respect_dnt == 1 %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
              <p class="help-block">{{ text_help_dnt }}</p>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
