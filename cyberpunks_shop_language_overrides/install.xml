<?xml version="1.0" encoding="utf-8"?>
<modification>
	<name>Cyberpunks Shop Language Overrides</name>
	<code>cyberpunks_shop_language_overrides</code>
	<version>1.5.2</version>
	<author>positivecrash</author>
	<description>Admin-managed storefront language overrides (catalog language files), cart total labels, and price thousand separator.</description>

	<file path="catalog/controller/startup/startup.php">
		<operation error="skip">
			<search><![CDATA[		$language->load($code);
		
		$this->registry->set('language', $language);]]></search>
			<add position="replace"><![CDATA[		$language->load($code);

		$cp_language_overrides_file = DIR_SYSTEM . 'library/cyberpunks_language_overrides.php';
		if (is_file($cp_language_overrides_file)) {
			require_once($cp_language_overrides_file);
			CyberpunksLanguageOverrides::apply($language, $code, $this->config);
		}

		$this->registry->set('language', $language);]]></add>
		</operation>
		<operation error="skip">
			<search><![CDATA[		$this->registry->set('language', $language);]]></search>
			<add position="after"><![CDATA[
		$cp_thousand_point = $this->config->get('module_cyberpunks_language_overrides_thousand_point');
		$cp_thousand_map = array(
			'space' => ' ',
			'comma' => ',',
			'dot'   => '.',
			'nbsp'  => "\xc2\xa0",
			'none'  => ''
		);
		if (is_string($cp_thousand_point) && isset($cp_thousand_map[$cp_thousand_point])) {
			$language->set('thousand_point', $cp_thousand_map[$cp_thousand_point]);
		}
]]></add>
		</operation>
	</file>

	<file path="system/engine/loader.php">
		<operation error="skip">
			<search><![CDATA[			$output = $this->registry->get('language')->load($route, $key);]]></search>
			<add position="after"><![CDATA[
			if (!$key) {
				require_once(DIR_SYSTEM . 'library/cyberpunks_language_overrides.php');
				CyberpunksLanguageOverrides::apply($this->registry->get('language'), $route, $this->registry->get('config'));
			}
]]></add>
		</operation>
	</file>

	<file path="catalog/controller/checkout/cart.php">
		<operation error="skip">
			<search><![CDATA[$data['totals'] = array();]]></search>
			<add position="after"><![CDATA[
			$cp_total_label_overrides = $this->config->get('module_cyberpunks_language_overrides_total_labels');
			if (!is_array($cp_total_label_overrides)) {
				$cp_total_label_overrides = array();
			}
			]]></add>
		</operation>

		<operation error="skip">
			<search><![CDATA[$data['totals'][] = array(]]></search>
			<add position="before"><![CDATA[
				$cp_total_code = isset($total['code']) ? (string)$total['code'] : '';
				$cp_total_title = $total['title'];
				if ($cp_total_code !== '' && !empty($cp_total_label_overrides[$cp_total_code])) {
					$cp_total_title = $cp_total_label_overrides[$cp_total_code];
				}
			]]></add>
		</operation>

		<operation error="skip">
			<search><![CDATA['title' => $total['title'],]]></search>
			<add position="replace"><![CDATA['title' => $cp_total_title,]]></add>
		</operation>
	</file>

	<file path="catalog/controller/checkout/payment_method.php">
		<operation error="skip">
			<search><![CDATA[$data['text_agree'] = sprintf($this->language->get('text_agree'), $this->url->link('information/information/agree', 'information_id=' . $this->config->get('config_checkout_id'), true), $information_info['title']);]]></search>
			<add position="replace"><![CDATA[
				$cp_text_agree_tpl = (string)$this->language->get('text_agree');
				$cp_text_agree_args = substr_count($cp_text_agree_tpl, '%s');
				$cp_text_agree_url = $this->url->link('information/information', 'information_id=' . $this->config->get('config_checkout_id'), true);

				// OpenCart convention:
				// - if text_agree has 1 placeholder: it expects the FULL HTML link (already formatted)
				// - if it has 2 placeholders: it expects (url, title)
				if ($cp_text_agree_args <= 0) {
					$data['text_agree'] = $cp_text_agree_tpl;
				} elseif ($cp_text_agree_args === 1) {
					$cp_text_agree_link = '<a href="' . $cp_text_agree_url . '" class="agree" target="_blank" rel="noopener noreferrer"><b>' . $information_info['title'] . '</b></a>';
					$data['text_agree'] = sprintf($cp_text_agree_tpl, $cp_text_agree_link);
				} else {
					$data['text_agree'] = sprintf($cp_text_agree_tpl, $cp_text_agree_url, $information_info['title']);
				}
			]]></add>
		</operation>
	</file>
</modification>
