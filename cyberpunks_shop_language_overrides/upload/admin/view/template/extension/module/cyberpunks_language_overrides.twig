{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-language-overrides" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-language-overrides" class="form-horizontal">
          <fieldset style="margin-bottom: 20px;">
            <legend>{{ text_price_format }}</legend>
            <p class="help-block">{{ text_price_format_help }}</p>
            <div class="form-group">
              <label class="col-sm-3 control-label" for="input-thousand-point">{{ entry_thousand_point }}</label>
              <div class="col-sm-9">
                <select name="module_cyberpunks_language_overrides_thousand_point" id="input-thousand-point" class="form-control">
                  {% for value, label in thousand_point_options %}
                    <option value="{{ value }}"{% if thousand_point == value %} selected="selected"{% endif %}>{{ label }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
          </fieldset>

          <fieldset style="margin-bottom: 20px;">
            <legend>{{ text_total_labels }}</legend>
            <p class="help-block">{{ text_total_labels_help }}</p>
            <div class="table-responsive">
              <table class="table table-bordered table-hover">
                <thead>
                  <tr>
                    <td class="text-left" style="width: 30%;">{{ text_total_code }}</td>
                    <td class="text-left" style="width: 30%;">{{ text_original }}</td>
                    <td class="text-left" style="width: 40%;">{{ text_override }}</td>
                  </tr>
                </thead>
                <tbody>
                  {% for row in total_labels %}
                    <tr{% if row.has_override %} class="info"{% endif %}>
                      <td><code>{{ row.code }}</code></td>
                      <td>{{ row.default }}</td>
                      <td>
                        <input type="text" name="module_cyberpunks_language_overrides_total_labels[{{ row.code }}]" value="{{ row.override }}" class="form-control" placeholder="Leave empty to use original" />
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </fieldset>

          {% for group in language_groups %}
            <fieldset style="margin-bottom: 20px;">
              <legend>{{ group.title }}</legend>
              {% if group.route %}
                <p class="help-block"><code>catalog/language/en-gb/{{ group.route }}.php</code></p>
              {% endif %}
              <div class="table-responsive">
                <table class="table table-bordered table-hover">
                  <thead>
                    <tr>
                      <td class="text-left" style="width: 20%;">{{ text_key }}</td>
                      <td class="text-left" style="width: 35%;">{{ text_original }}</td>
                      <td class="text-left" style="width: 45%;">{{ text_override }}</td>
                    </tr>
                  </thead>
                  <tbody>
                    {% for row in group.strings %}
                      <tr{% if row.has_override %} class="info"{% endif %}>
                        <td><code>{{ row.key }}</code></td>
                        <td>{{ row.original }}</td>
                        <td>
                          <input type="text" name="module_cyberpunks_language_overrides_map[{{ row.map_key }}]" value="{{ row.override }}" class="form-control" placeholder="Leave empty to use original" />
                        </td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </fieldset>
          {% endfor %}
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
