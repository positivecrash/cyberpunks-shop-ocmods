<script>
    document.querySelectorAll('.delete-backup').forEach(btn => {
      btn.addEventListener('click', e => {
        if(!confirm('{{ text_confirm_delete }}')) e.preventDefault();
      });
    });
 
document.addEventListener('DOMContentLoaded', function() {
  const checkAll = document.getElementById('check-all');
  const checkboxes = document.querySelectorAll('.file-checkbox');
  const msgBox = document.getElementById('bulk-message');
  const msgText = document.getElementById('bulk-message-text');

  function updateMessage() {
    const selectedCount = document.querySelectorAll('.file-checkbox:checked').length;
    if (selectedCount > 0) {
      msgBox.style.display = 'block';
      msgBox.className = 'alert alert-success';
const langText = '{{ text_selected_backups|e('js') }}';

let wordPlural = '';
let wordSuffix = '';

if (langText.includes('selected')) {
    // English plural logic
    wordPlural = (selectedCount > 1 ? 's' : '');
} else {
    // Romanian plural logic
    wordPlural = (selectedCount > 1 ? 'uri' : '');
    wordSuffix = (selectedCount > 1 ? 'e' : '');
}

msgText.textContent = langText
    .replace('%s', selectedCount)
    .replace('%s', wordPlural)
    .replace('%s', wordSuffix);    } else {
      msgBox.style.display = 'none';
    }
  }

  checkAll.addEventListener('change', function() {
    checkboxes.forEach(cb => cb.checked = checkAll.checked);
    updateMessage();
  });

  checkboxes.forEach(cb => cb.addEventListener('change', updateMessage));
});


$(document).ready(function() {
  const t_generate = '{{ text_backup_generating }}';
  const t_success  = '{{ text_backup_success }}';
  const t_error    = '{{ text_backup_error }}';
  const t_unknown  = '{{ text_backup_unknown }}';
  const t_button   = '{{ text_backup_now }}';
  const t_reload   = '{{ text_reload_after_backup|default("Se reîncarcă pagina...") }}';

  $('#btn-backup-now').on('click', function(e) {
    e.preventDefault();
    const btn = $(this);
    const url = btn.data('url');

    btn.prop('disabled', true)
       .html('<i class="fa fa-spinner fa-spin"></i> ' + t_generate);

    $.ajax({
      url: url,
      type: 'POST',
      dataType: 'json',
      data: { user_token: '{{ user_token }}' },
      success: function(json) {
        if (json.success) {
          showAlert('success', ' ' + t_success);

          // 🕒 Așteaptă 2 secunde, apoi reîncarcă pagina
          setTimeout(function() {
            showAlert('info', ' ' + t_reload);
            location.reload();
          }, 2000);

        } else {
          showAlert('danger', '' + t_error + '' + (json.message || t_unknown) + '');
        }
      },
      error: function(xhr) {
        showAlert('warning', '<i class="fa fa-exclamation-triangle"></i> ' + t_unknown + '' + xhr.responseText.substring(0, 200) + '');
      },
      complete: function() {
        btn.prop('disabled', false)
           .html('<i class="fa fa-database"></i> ' + t_button);
      }
    });
  });

  function showAlert(type, message) {
    $('.alert-dismissible').remove();
    const alertHtml = `
      <div class="alert alert-${type} alert-dismissible" 
           style="f">
        ${message}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>`;
    $('#content > .container-fluid').prepend(alertHtml);
    $('html, body').animate({ scrollTop: 0 }, 'slow');
  }
});
document.addEventListener('DOMContentLoaded', function() {
  const input = document.getElementById('ftp-path-input');
  const warning = document.getElementById('ftp-warning');

  if (input) {
    input.addEventListener('input', function() {
      const val = input.value.toLowerCase().trim();
      if (val.includes('digi') && !val.includes('/digi cloud/backup')) {
        warning.style.display = 'block';
      } else {
        warning.style.display = 'none';
      }
    });
  }
});
document.getElementById('copy-cron').addEventListener('click', function() {
  var cronInput = document.getElementById('cron-line');
  cronInput.select();
  document.execCommand('copy');
  this.innerHTML = '<i class="fa fa-check"></i> {{ text_copied }}';
  setTimeout(() => { this.innerHTML = '<i class="fa fa-copy"></i> {{ button_copy_cron }}'; }, 1500);
});
</script>

