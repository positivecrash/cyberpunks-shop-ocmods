{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-cyberpunks-option-fields" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-cyberpunks-option-fields" class="form-horizontal">
          <input type="hidden" name="active_tab" id="input-active-tab" value="{{ active_tab }}" />
          <ul class="nav nav-tabs">
            <li class="{% if active_tab != 'palettes' %}active{% endif %}"><a href="#tab-fields" data-toggle="tab" data-tab-name="fields">{{ tab_fields }}</a></li>
            <li class="{% if active_tab == 'palettes' %}active{% endif %}"><a href="#tab-palettes" data-toggle="tab" data-tab-name="palettes">{{ tab_palettes }}</a></li>
          </ul>
          <div class="tab-content">
            <div class="tab-pane{% if active_tab != 'palettes' %} active{% endif %}" id="tab-fields">
              <table id="cyberpunks-fields" class="table table-striped table-bordered table-hover">
                <thead>
                  <tr>
                    <td class="text-left">{{ entry_key }}</td>
                    <td class="text-left">{{ entry_label }}</td>
                    <td class="text-left">{{ entry_type }}</td>
                    <td class="text-left">{{ entry_scope }}</td>
                    <td class="text-right">{{ entry_sort_order }}</td>
                    <td class="text-left">{{ entry_status }}</td>
                    <td></td>
                  </tr>
                </thead>
                <tbody>
                  {% set field_row = 0 %}
                  {% for field in fields %}
                  <tr id="field-row-{{ field_row }}">
                    <td class="text-left"><input type="text" name="cyberpunks_custom_fields[{{ field_row }}][field_key]" value="{{ field.field_key is defined ? field.field_key : '' }}" class="form-control" /></td>
                    <td class="text-left"><input type="text" name="cyberpunks_custom_fields[{{ field_row }}][label]" value="{{ field.label is defined ? field.label : '' }}" class="form-control" /></td>
                    <td class="text-left">
                      <select name="cyberpunks_custom_fields[{{ field_row }}][field_type]" class="form-control">
                        <option value="text" {% if field.field_type is not defined or field.field_type == 'text' %}selected="selected"{% endif %}>{{ text_text }}</option>
                        <option value="textarea" {% if field.field_type is defined and field.field_type == 'textarea' %}selected="selected"{% endif %}>{{ text_textarea }}</option>
                        <option value="boolean" {% if field.field_type is defined and field.field_type == 'boolean' %}selected="selected"{% endif %}>{{ text_boolean }}</option>
                      </select>
                    </td>
                    <td class="text-left">
                      <select name="cyberpunks_custom_fields[{{ field_row }}][scope]" class="form-control">
                        <option value="option" {% if field.scope is defined and field.scope == 'option' %}selected="selected"{% endif %}>{{ text_scope_option }}</option>
                        <option value="option_value" {% if field.scope is not defined or field.scope == 'option_value' %}selected="selected"{% endif %}>{{ text_scope_option_value }}</option>
                      </select>
                    </td>
                    <td class="text-right"><input type="text" name="cyberpunks_custom_fields[{{ field_row }}][sort_order]" value="{{ field.sort_order is defined ? field.sort_order : 0 }}" class="form-control" /></td>
                    <td class="text-left">
                      <select name="cyberpunks_custom_fields[{{ field_row }}][status]" class="form-control">
                        <option value="1" {% if field.status is not defined or field.status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                        <option value="0" {% if field.status is defined and not field.status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                      </select>
                    </td>
                    <td class="text-right"><button type="button" onclick="$('#field-row-{{ field_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>
                  </tr>
                  {% set field_row = field_row + 1 %}
                  {% endfor %}
                </tbody>
                <tfoot>
                  <tr>
                    <td colspan="6"></td>
                    <td class="text-right"><button type="button" onclick="addCustomField();" data-toggle="tooltip" title="{{ button_add_field }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td>
                  </tr>
                </tfoot>
              </table>
            </div>
            <div class="tab-pane{% if active_tab == 'palettes' %} active{% endif %}" id="tab-palettes">
              <p class="help-block">{{ help_palettes }}</p>
              <div id="palettes">
                {% set palette_row = 0 %}
                {% for palette in palettes %}
                <div class="panel panel-default palette-item" id="palette-row-{{ palette_row }}">
                  <div class="panel-heading">
                    <h3 class="panel-title">{{ text_palette }} #{{ palette_row + 1 }}
                      <button type="button" class="btn btn-danger btn-xs pull-right" onclick="$('#palette-row-{{ palette_row }}').remove();" title="{{ button_remove }}"><i class="fa fa-minus-circle"></i></button>
                    </h3>
                  </div>
                  <div class="panel-body">
                    <input type="hidden" name="cyberpunks_color_palettes[{{ palette_row }}][palette_id]" value="{{ palette.palette_id is defined ? palette.palette_id : 0 }}" />
                    <div class="form-group">
                      <label class="col-sm-2 control-label">{{ entry_name }}</label>
                      <div class="col-sm-4">
                        <input type="text" name="cyberpunks_color_palettes[{{ palette_row }}][name]" value="{{ palette.name is defined ? palette.name : '' }}" class="form-control" />
                      </div>
                      <label class="col-sm-2 control-label">{{ entry_sort_order }}</label>
                      <div class="col-sm-1">
                        <input type="text" name="cyberpunks_color_palettes[{{ palette_row }}][sort_order]" value="{{ palette.sort_order is defined ? palette.sort_order : 0 }}" class="form-control" />
                      </div>
                      <label class="col-sm-1 control-label">{{ entry_status }}</label>
                      <div class="col-sm-2">
                        <select name="cyberpunks_color_palettes[{{ palette_row }}][status]" class="form-control">
                          <option value="1" {% if palette.status is not defined or palette.status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                          <option value="0" {% if palette.status is defined and not palette.status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                        </select>
                      </div>
                    </div>
                    <table class="table table-bordered table-hover palette-colors">
                      <thead>
                        <tr>
                          <td class="text-left">{{ entry_name }}</td>
                          <td class="text-left">{{ entry_swatch_color }}</td>
                          <td class="text-left">{{ entry_model_color }}</td>
                          <td class="text-left">{{ entry_in_stock }}</td>
                          <td class="text-right">{{ entry_sort_order }}</td>
                          <td></td>
                        </tr>
                      </thead>
                      <tbody>
                        {% set color_row = 0 %}
                        {% for color in palette.colors %}
                        <tr id="palette-{{ palette_row }}-color-{{ color_row }}">
                          <td class="text-left">
                            <input type="hidden" name="cyberpunks_color_palettes[{{ palette_row }}][colors][{{ color_row }}][color_id]" value="{{ color.color_id is defined ? color.color_id : 0 }}" />
                            <input type="text" name="cyberpunks_color_palettes[{{ palette_row }}][colors][{{ color_row }}][name]" value="{{ color.name is defined ? color.name : '' }}" class="form-control" />
                          </td>
                          <td class="text-left"><input type="text" name="cyberpunks_color_palettes[{{ palette_row }}][colors][{{ color_row }}][swatch_color]" value="{{ color.swatch_color is defined ? color.swatch_color : '' }}" class="form-control" /></td>
                          <td class="text-left"><input type="text" name="cyberpunks_color_palettes[{{ palette_row }}][colors][{{ color_row }}][model_color]" value="{{ color.model_color is defined ? color.model_color : '' }}" class="form-control" /></td>
                          <td class="text-left">
                            <select name="cyberpunks_color_palettes[{{ palette_row }}][colors][{{ color_row }}][in_stock]" class="form-control">
                              <option value="1" {% if color.in_stock is not defined or color.in_stock %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                              <option value="0" {% if color.in_stock is defined and not color.in_stock %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                            </select>
                          </td>
                          <td class="text-right"><input type="text" name="cyberpunks_color_palettes[{{ palette_row }}][colors][{{ color_row }}][sort_order]" value="{{ color.sort_order is defined ? color.sort_order : 0 }}" class="form-control" /></td>
                          <td class="text-right"><button type="button" onclick="$('#palette-{{ palette_row }}-color-{{ color_row }}').remove();" class="btn btn-danger" title="{{ button_remove }}"><i class="fa fa-minus-circle"></i></button></td>
                        </tr>
                        {% set color_row = color_row + 1 %}
                        {% endfor %}
                      </tbody>
                      <tfoot>
                        <tr>
                          <td colspan="5"></td>
                          <td class="text-right"><button type="button" onclick="addPaletteColor({{ palette_row }});" class="btn btn-primary" title="{{ button_add_color }}"><i class="fa fa-plus-circle"></i></button></td>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                </div>
                {% set palette_row = palette_row + 1 %}
                {% endfor %}
              </div>
              <div class="text-right" style="margin-top:12px;">
                <button type="button" onclick="addPalette();" class="btn btn-primary"><i class="fa fa-plus-circle"></i> {{ button_add_palette }}</button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var field_row = {{ field_row }};
var palette_row = {{ palette_row }};
var palette_color_rows = {};

$('a[data-toggle="tab"]').on('shown.bs.tab', function(e) {
  $('#input-active-tab').val($(e.target).data('tab-name'));
});

function nextSortOrder($inputs) {
  var max = -1;

  $inputs.each(function() {
    var value = parseInt($(this).val(), 10);

    if (!isNaN(value) && value > max) {
      max = value;
    }
  });

  return max + 1;
}

function addCustomField() {
  var sortOrder = nextSortOrder($('#cyberpunks-fields tbody input[name$="[sort_order]"]'));
  var html = '';
  html += '<tr id="field-row-' + field_row + '">';
  html += '  <td class="text-left"><input type="text" name="cyberpunks_custom_fields[' + field_row + '][field_key]" value="" class="form-control" /></td>';
  html += '  <td class="text-left"><input type="text" name="cyberpunks_custom_fields[' + field_row + '][label]" value="" class="form-control" /></td>';
  html += '  <td class="text-left"><select name="cyberpunks_custom_fields[' + field_row + '][field_type]" class="form-control"><option value="text">{{ text_text }}</option><option value="textarea">{{ text_textarea }}</option><option value="boolean">{{ text_boolean }}</option></select></td>';
  html += '  <td class="text-left"><select name="cyberpunks_custom_fields[' + field_row + '][scope]" class="form-control"><option value="option">{{ text_scope_option }}</option><option value="option_value" selected="selected">{{ text_scope_option_value }}</option></select></td>';
  html += '  <td class="text-right"><input type="text" name="cyberpunks_custom_fields[' + field_row + '][sort_order]" value="' + sortOrder + '" class="form-control" /></td>';
  html += '  <td class="text-left"><select name="cyberpunks_custom_fields[' + field_row + '][status]" class="form-control"><option value="1">{{ text_enabled }}</option><option value="0">{{ text_disabled }}</option></select></td>';
  html += '  <td class="text-right"><button type="button" onclick="$(\'#field-row-' + field_row + '\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
  html += '</tr>';

  $('#cyberpunks-fields tbody').append(html);
  field_row++;
}

function addPaletteColor(paletteRow) {
  if (!palette_color_rows[paletteRow]) {
    palette_color_rows[paletteRow] = 0;
  }

  var colorRow = palette_color_rows[paletteRow];
  var sortOrder = nextSortOrder($('#palette-row-' + paletteRow + ' .palette-colors tbody input[name$="[sort_order]"]'));
  var html = '';
  html += '<tr id="palette-' + paletteRow + '-color-' + colorRow + '">';
  html += '  <td class="text-left"><input type="hidden" name="cyberpunks_color_palettes[' + paletteRow + '][colors][' + colorRow + '][color_id]" value="0" />';
  html += '  <input type="text" name="cyberpunks_color_palettes[' + paletteRow + '][colors][' + colorRow + '][name]" value="" class="form-control" /></td>';
  html += '  <td class="text-left"><input type="text" name="cyberpunks_color_palettes[' + paletteRow + '][colors][' + colorRow + '][swatch_color]" value="" class="form-control" /></td>';
  html += '  <td class="text-left"><input type="text" name="cyberpunks_color_palettes[' + paletteRow + '][colors][' + colorRow + '][model_color]" value="" class="form-control" /></td>';
  html += '  <td class="text-left"><select name="cyberpunks_color_palettes[' + paletteRow + '][colors][' + colorRow + '][in_stock]" class="form-control"><option value="1" selected="selected">{{ text_enabled }}</option><option value="0">{{ text_disabled }}</option></select></td>';
  html += '  <td class="text-right"><input type="text" name="cyberpunks_color_palettes[' + paletteRow + '][colors][' + colorRow + '][sort_order]" value="' + sortOrder + '" class="form-control" /></td>';
  html += '  <td class="text-right"><button type="button" onclick="$(\'#palette-' + paletteRow + '-color-' + colorRow + '\').remove();" class="btn btn-danger" title="{{ button_remove }}"><i class="fa fa-minus-circle"></i></button></td>';
  html += '</tr>';

  $('#palette-row-' + paletteRow + ' .palette-colors tbody').append(html);
  palette_color_rows[paletteRow]++;
}

function addPalette() {
  var sortOrder = nextSortOrder($('#palettes > .palette-item > .panel-body > .form-group input[name$="[sort_order]"]'));
  var html = '';
  html += '<div class="panel panel-default palette-item" id="palette-row-' + palette_row + '">';
  html += '  <div class="panel-heading"><h3 class="panel-title">{{ text_palette }} #' + (palette_row + 1);
  html += '    <button type="button" class="btn btn-danger btn-xs pull-right" onclick="$(\'#palette-row-' + palette_row + '\').remove();" title="{{ button_remove }}"><i class="fa fa-minus-circle"></i></button>';
  html += '  </h3></div>';
  html += '  <div class="panel-body">';
  html += '    <input type="hidden" name="cyberpunks_color_palettes[' + palette_row + '][palette_id]" value="0" />';
  html += '    <div class="form-group">';
  html += '      <label class="col-sm-2 control-label">{{ entry_name }}</label>';
  html += '      <div class="col-sm-4"><input type="text" name="cyberpunks_color_palettes[' + palette_row + '][name]" value="" class="form-control" /></div>';
  html += '      <label class="col-sm-2 control-label">{{ entry_sort_order }}</label>';
  html += '      <div class="col-sm-1"><input type="text" name="cyberpunks_color_palettes[' + palette_row + '][sort_order]" value="' + sortOrder + '" class="form-control" /></div>';
  html += '      <label class="col-sm-1 control-label">{{ entry_status }}</label>';
  html += '      <div class="col-sm-2"><select name="cyberpunks_color_palettes[' + palette_row + '][status]" class="form-control"><option value="1" selected="selected">{{ text_enabled }}</option><option value="0">{{ text_disabled }}</option></select></div>';
  html += '    </div>';
  html += '    <table class="table table-bordered table-hover palette-colors"><thead><tr>';
  html += '      <td class="text-left">{{ entry_name }}</td>';
  html += '      <td class="text-left">{{ entry_swatch_color }}</td>';
  html += '      <td class="text-left">{{ entry_model_color }}</td>';
  html += '      <td class="text-left">{{ entry_in_stock }}</td>';
  html += '      <td class="text-right">{{ entry_sort_order }}</td><td></td>';
  html += '    </tr></thead><tbody></tbody>';
  html += '    <tfoot><tr><td colspan="5"></td><td class="text-right"><button type="button" onclick="addPaletteColor(' + palette_row + ');" class="btn btn-primary" title="{{ button_add_color }}"><i class="fa fa-plus-circle"></i></button></td></tr></tfoot>';
  html += '    </table>';
  html += '  </div>';
  html += '</div>';

  $('#palettes').append(html);
  palette_color_rows[palette_row] = 0;
  palette_row++;
}

$('.palette-item').each(function() {
  var id = $(this).attr('id').replace('palette-row-', '');
  palette_color_rows[id] = $(this).find('.palette-colors tbody tr').length;
});
//--></script>
{{ footer }}
