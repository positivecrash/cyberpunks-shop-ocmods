{% for field in cyberpunks_product_custom_fields %}
<div class="form-group">
  <label class="col-sm-2 control-label" for="input-cyberpunks-product-field-{{ field.field_id }}">{{ field.label }}</label>
  <div class="col-sm-10">
    {% if field.field_type == 'textarea' %}
    <textarea name="cyberpunks_product_custom_fields[{{ field.field_id }}]" rows="5" placeholder="{{ field.label }}" id="input-cyberpunks-product-field-{{ field.field_id }}" class="form-control">{{ cyberpunks_product_custom_field_values[field.field_id] is defined ? cyberpunks_product_custom_field_values[field.field_id] : '' }}</textarea>
    {% elseif field.field_type == 'boolean' %}
    <label class="checkbox-inline">
      <input type="checkbox" name="cyberpunks_product_custom_fields[{{ field.field_id }}]" value="1" id="input-cyberpunks-product-field-{{ field.field_id }}" {% if cyberpunks_product_custom_field_values[field.field_id] is defined and cyberpunks_product_custom_field_values[field.field_id] %}checked="checked"{% endif %}/>
    </label>
    {% else %}
    <input type="text" name="cyberpunks_product_custom_fields[{{ field.field_id }}]" value="{{ cyberpunks_product_custom_field_values[field.field_id] is defined ? cyberpunks_product_custom_field_values[field.field_id] : '' }}" placeholder="{{ field.label }}" id="input-cyberpunks-product-field-{{ field.field_id }}" class="form-control" />
    {% endif %}
  </div>
</div>
{% endfor %}
