{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-blocklist-add" data-toggle="tooltip" title="{{ button_blacklist_add }}" class="btn btn-warning"><i class="fa fa-ban"></i></button>
        <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-blocklist').submit() : false;"><i class="fa fa-trash-o"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-ban"></i> {{ text_blocklist_add }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-blocklist-add" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-emails">{{ entry_blocklist_emails }}</label>
            <div class="col-sm-10">
              <textarea name="emails" rows="3" id="input-emails" class="form-control" placeholder="spammer@example.com"></textarea>
              <p class="help-block">{{ help_blocklist_emails }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-note">{{ entry_blocklist_note }}</label>
            <div class="col-sm-10">
              <input type="text" name="note" value="" id="input-note" class="form-control" maxlength="255" />
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-list"></i> {{ text_blocklist_list }}</h3></div>
      <div class="panel-body">
        <div class="well">
          <div class="row">
            <div class="col-sm-6">
              <div class="form-group">
                <label class="control-label" for="input-filter-email">{{ entry_email }}</label>
                <input type="text" name="filter_email" value="{{ filter_email }}" placeholder="{{ entry_email }}" id="input-filter-email" class="form-control" />
              </div>
              <button type="button" id="button-filter" class="btn btn-primary"><i class="fa fa-filter"></i> {{ button_filter }}</button>
            </div>
          </div>
        </div>
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-blocklist">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                  <td>{{ column_email }}</td>
                  <td>{{ column_note }}</td>
                  <td>{{ column_date_added }}</td>
                </tr>
              </thead>
              <tbody>
                {% if blocked %}
                {% for row in blocked %}
                <tr>
                  <td class="text-center"><input type="checkbox" name="selected[]" value="{{ row.block_id }}" /></td>
                  <td>{{ row.email }}</td>
                  <td>{{ row.note }}</td>
                  <td>{{ row.date_added }}</td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="4">{{ text_no_blocked }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
        <div class="row">
          <div class="col-sm-6 text-left">{{ pagination }}</div>
          <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-filter').on('click', function() {
  var url = 'index.php?route=extension/module/cyberpunks_shop_support/blocklist&user_token={{ user_token }}';
  var email = $('input[name=\'filter_email\']').val();
  if (email) url += '&filter_email=' + encodeURIComponent(email);
  location = url;
});
//--></script>
{{ footer }}
